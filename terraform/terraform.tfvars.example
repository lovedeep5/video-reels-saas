# Copy this file to terraform.tfvars for local runs.
# In CI, these are injected as TF_VAR_* GitHub Actions secrets.
# NEVER commit terraform.tfvars — it's in .gitignore.

aws_region           = "ap-south-1"
s3_bucket            = "vidtoreel-bucket"
worker_ami_id        = ""
worker_instance_type = "t3.small"
worker_subnet_id     = "subnet-XXXXXXXXXX"
environment          = "prod"
max_concurrent_jobs  = 10
stale_job_minutes    = 35
max_job_retries      = 3
mongodb_db_name      = "vidtoreels"

mongodb_uri              = "mongodb+srv://..."
clerk_secret_key         = "sk_live_..."
clerk_jwks_url           = "https://your-clerk.clerk.accounts.dev/.well-known/jwks.json"
clerk_authorized_parties = "https://vidtoreels.com,http://localhost:3000"
app_secret_key           = ""
openrouter_api_key       = "sk-or-v1-..."
razorpay_key_id          = "rzp_live_..."
razorpay_key_secret      = ""
razorpay_webhook_secret  = ""
